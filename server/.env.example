# Demo backend secrets â€” never commit a real .env with credentials.
#
# Copy to server/.env and fill in TEST / Sandbox values only.

# Stripe TEST MODE only. Angular uses YOUR_STRIPE_PUBLISHABLE_KEY (pk_test_...).
# Klarna / Affirm (Easy Payments) also use this Stripe secret â€” enable them in the Stripe Dashboard (TEST).
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# Optional. Stripe webhook signing secret (whsec_...) for POST /api/webhooks/stripe.
# Server-only. Never put this in Angular. Omit to leave Stripe webhooks unavailable (safe 503).
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# PayPal Sandbox REST credentials from https://developer.paypal.com/dashboard/
# Angular receives YOUR_PAYPAL_CLIENT_ID only (never the secret).
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
# sandbox (default) | live â€” keep sandbox for local demos
PAYPAL_MODE=sandbox

# Optional. PayPal webhook id for POST /api/webhooks/paypal verification.
# Server-only. Never put this in Angular. Omit to leave PayPal webhooks unavailable (safe 503).
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# Zip US Gateway (sandbox). From Zip Merchant Portal Settings.
# When omitted, the demo server signs checkouts with a local mock secret (no live Zip popup).
# ZIP_MERCHANT_ID=YOUR_ZIP_MERCHANT_ID
# ZIP_API_SECRET=YOUR_ZIP_API_SECRET
# sandbox (default) | live — keep sandbox for local demos
ZIP_MODE=sandbox
# Public HTTPS URL Zip will POST callbacks to (ngrok / deployed API).
# ZIP_CALLBACK_URL=https://your-tunnel.example/api/webhooks/zip

# Local default 3001 (avoids common conflict with other apps on 3000).
PORT=3001
# Comma-separated origins allowed. Include both local hosts when needed.
FRONTEND_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
